{
  "expo": {
    "name": "PropertiesDock",
    "slug": "PropertyDockMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "propertydockmobile",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "app.propertydock.mobile",
      "associatedDomains": [
        "applinks:propertydock.app"
      ]
    },
    "android": {
      "package": "app.propertydock.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#208AEF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "propertydock.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/android-icon-foreground.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PropertiesDock to access your photos so you can add them to a listing.",
          "cameraPermission": "Allow PropertiesDock to use your camera so you can photograph a property for a listing."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock PropertiesDock with Face ID."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://propertydockbackend-2.onrender.com",
      "router": {},
      "eas": {
        "projectId": "e1448a15-d66d-44a6-9d8a-d5eb717d2dc4"
      }
    },
    "owner": "qasim-khan",
    "updates": {
      "url": "https://u.expo.dev/e1448a15-d66d-44a6-9d8a-d5eb717d2dc4"
    }
  }
}
